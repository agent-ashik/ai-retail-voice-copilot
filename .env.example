# Application Configuration
APP_NAME=AI Retail Voice Copilot
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/retail_voice_copilot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=86400

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# AWS Transcribe
AWS_TRANSCRIBE_LANGUAGE_CODES=en-US,hi-IN,ta-IN,bn-IN

# AWS Polly
AWS_POLLY_VOICE_EN=Joanna
AWS_POLLY_VOICE_HI=Aditi
AWS_POLLY_VOICE_TA=Aditi
AWS_POLLY_VOICE_BN=Aditi

# AWS Lex
AWS_LEX_BOT_ID=your_bot_id
AWS_LEX_BOT_ALIAS_ID=your_bot_alias_id
AWS_LEX_LOCALE_ID=en_US

# S3 Configuration
AWS_S3_BUCKET=retail-voice-recordings
AWS_S3_RECORDING_TTL_DAYS=30

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Forecasting Configuration
FORECAST_HORIZON_DAYS=30
FORECAST_MIN_HISTORY_DAYS=30
FORECAST_CACHE_TTL_HOURS=24

# Inventory Thresholds
OVERSTOCK_THRESHOLD_MULTIPLIER=1.5
ANOMALY_DETECTION_STD_DEV_THRESHOLD=2.0
ANOMALY_DETECTION_WINDOW_DAYS=30

# Replenishment Configuration
REPLENISHMENT_URGENCY_HIGH_DAYS=3
REPLENISHMENT_URGENCY_MEDIUM_DAYS=7

# Performance Configuration
QUERY_TIMEOUT_SECONDS=5
MAX_CONCURRENT_REQUESTS=100
REQUEST_QUEUE_SIZE=500

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
